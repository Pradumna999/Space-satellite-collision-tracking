# Copy to .env and edit. Never commit .env. No real credentials belong in this file.
ASTRAL_PROFILE=production
ASTRAL_SECRET_KEY=replace-with-output-of-python -c "import secrets;print(secrets.token_urlsafe(32))"
ASTRAL_COOKIE_SECURE=true
ASTRAL_ALLOWED_ORIGINS=["https://astral.example.org"]
POSTGRES_PASSWORD=replace-me
# Limits
ASTRAL_MAX_UPLOAD_MB=25
ASTRAL_MAX_OBJECTS_PER_JOB=5000
ASTRAL_MAX_WINDOW_DAYS=14
ASTRAL_MAX_CONCURRENT_JOBS=2
ASTRAL_MAX_JOBS_PER_USER_PER_HOUR=30
ASTRAL_RATE_LIMIT_PER_MINUTE=240
ASTRAL_AUTH_RATE_LIMIT_PER_MINUTE=10
ASTRAL_RETENTION_DAYS_UPLOADS=365
# Optional providers
ASTRAL_CELESTRAK_ENABLED=true
# ASTRAL_SPACETRACK_USERNAME=
# ASTRAL_SPACETRACK_PASSWORD=
# ASTRAL_HTTP_PORT=8000
